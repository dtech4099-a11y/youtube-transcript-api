NODE_ENV=development

# Comma-separated API keys accepted via x-api-key or Authorization: Bearer <key>.
API_KEYS=dev-api-key-change-me

# Optional RapidAPI proxy secret. Configure the same value as a RapidAPI secret header:
# x-rapidapi-proxy-secret: <same value>
RAPIDAPI_PROXY_SECRET=rapidapi_proxy_replace_with_random_secret

# Upstash Redis REST credentials. Required in production for distributed cache and rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limit window and quota per API key.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60s

# Cache TTLs in seconds.
TRANSCRIPT_CACHE_TTL_SECONDS=86400
METADATA_CACHE_TTL_SECONDS=21600

# Base URL used in generated OpenAPI docs.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional YouTube cookies for yt-dlp fallback.
# Store a base64-encoded Netscape cookies.txt export. Never commit real cookies.
YOUTUBE_COOKIES_BASE64=

# Contact form email delivery. Use Resend in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL="YouTube Transcript API <onboarding@resend.dev>"
CONTACT_TO_EMAIL=dtech4099@gmail.com
